research/outputs/*.zip
thesis_data_backup*.zip
recovered_*_data/

# Experiment matrix: keep CSVs/figures/reports/manifest in git for periodic
# checkpoints, but exclude the large regenerable hidden-state tensors and logs
# (the persistent volume holds those). See research/run_experiment_matrix.py.
research/outputs/experiment_matrix/**/*.npz
research/outputs/experiment_matrix/**/*.log
research/outputs/experiment_matrix/_preflight/
# Offloaded weight shards can sit two levels deep under the matrix tree; the
# single-level rule above (research/outputs/*/model_offload/) misses them.
research/outputs/**/model_offload/
research/outputs/**/hidden_states/
# Autonomous v2 runner: keep the results (success_checks.log, n1n4_results.log,
# CSVs, per-cell caches); drop the firehose log and process bookkeeping.
research/outputs/experiments_v2/autonomous_run.log
research/outputs/experiments_v2/nohup.out
research/outputs/experiments_v2/.run.pid

