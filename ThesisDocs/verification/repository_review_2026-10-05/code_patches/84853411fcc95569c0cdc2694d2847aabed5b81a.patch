    fix: support pyarrow-backed string dtypes in _sanitize_step_frame and _escape_control_chars
    
    Resolves the TypeError when running algorithm_v2_experiments.py under Arrow-backed pandas dtype engines, enabling N1/N4 checks to complete successfully and log final verdicts.

diff --git a/research/real_trace_experiments.py b/research/real_trace_experiments.py
index 8a92744..a5989a3 100644
--- a/research/real_trace_experiments.py
+++ b/research/real_trace_experiments.py
@@ -1179,7 +1179,7 @@ def _escape_control_chars(frame: pd.DataFrame) -> pd.DataFrame:
     # quoting; everything else in C0 gets replaced.
     pattern = re.compile(r"[\x00-\x08\x0b-\x1f]")
     for column in frame.columns:
-        if frame[column].dtype == object:
+        if frame[column].dtype == object or pd.api.types.is_string_dtype(frame[column]):
             frame[column] = frame[column].map(
                 lambda value: pattern.sub(" ", value) if isinstance(value, str) else value
             )
