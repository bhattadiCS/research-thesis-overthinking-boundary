+def _last_boxed_content(s: str) -> str | None:
+    """Return the content of the last \\boxed{...} with balanced braces (handles
+    nesting like \\boxed{\\frac{1}{2}}, which a non-greedy regex truncates)."""
+    key = "\\boxed{"
+    idx = s.rfind(key)
+    if idx == -1:
+        return None
+    i = idx + len(key)
+    depth = 1
+    out: list[str] = []
+    while i < len(s) and depth > 0:
+        c = s[i]
+        if c == "{":
+            depth += 1
+        elif c == "}":
+            depth -= 1
+            if depth == 0:
+                break
+        out.append(c)
+        i += 1
+    return "".join(out)
