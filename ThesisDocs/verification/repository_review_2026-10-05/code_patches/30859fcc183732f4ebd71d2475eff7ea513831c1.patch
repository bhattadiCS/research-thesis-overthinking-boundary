+# Detect virtual environment python
+if [ -f ".venv/bin/python" ]; then
+    PY=".venv/bin/python"
+    echo "[INFO] Detected local virtualenv python: $PY"
+elif [ -f "../.venv/bin/python" ]; then
+    PY="../.venv/bin/python"
