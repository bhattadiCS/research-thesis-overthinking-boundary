+        generated[result["task_id"]][result["policy"]] = result
+        latency.extend({"task_id": result["task_id"], "policy": result["policy"], "step": d["step"], "latency_ms": d["latency_ns"] / 1e6} for d in result["decisions"])
+    if set(generated) != set(labels):
