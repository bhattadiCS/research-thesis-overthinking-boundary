+print(f"alpha (repair_rate) nonincreasing: {pa}/{tot}")
+print(f"beta (corruption_rate) nondecreasing: {pb}/{tot}")
+B.to_csv(os.path.join(ROOT,"_thesis_boundary_table.csv"),index=False)
